<div class="alert alert-success">
  <strong>Deleted.</strong> Commit <code>{{result.git.sha}}</code> {{#if result.pushed}}pushed to origin.{{else}}NOT pushed (SITE_REPO_PUSH=false).{{/if}}
</div>

<div class="card">
  <h2>{{project.service_label}} — {{project.city_name}}, IL</h2>
  <p class="muted">Slug: <code>{{project.slug}}</code></p>
  <ul class="list" style="font-size:14px;">
    <li>{{result.removed}} file{{#unless (eq result.removed 1)}}s{{/unless}} removed from the static-site repo (project HTML, photos, possibly empty archive pages)</li>
    <li>Spoke page <code>{{project.spoke_slug}}{{#unless project.spoke_slug}}{{project.city_slug}}{{/unless}}.html</code> updated (tile + footer link removed{{#if result.spoke.tilesRemoved}}, "View all" count refreshed{{/if}})</li>
    <li>Sitemap entry removed</li>
    <li>{{result.archives.length}} archive page{{#unless (eq result.archives.length 1)}}s{{/unless}} regenerated</li>
    <li>DB row deleted</li>
    {{#if (eq video.status "deleted")}}<li>YouTube video deleted from the channel</li>{{/if}}
    {{#if (eq video.status "already-gone")}}<li>YouTube video was already gone from the channel</li>{{/if}}
    {{#if (eq video.status "kept")}}<li>YouTube video left on the channel (you unticked "Also delete its video"): <a href="{{video.url}}" target="_blank" rel="noopener">{{video.url}}</a></li>{{/if}}
    {{#if (eq video.status "not-youtube")}}<li>Video wasn't on YouTube (e.g. Vimeo) — nothing deleted there: <a href="{{video.url}}" target="_blank" rel="noopener">{{video.url}}</a></li>{{/if}}
  </ul>
</div>

{{#if (eq video.status "shared")}}
<div class="alert" style="background:#fff8e1;border-color:#ffe082;color:#7a5400;">
  <strong>Video kept on YouTube</strong> because it's also used by: {{#each video.others}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}.
</div>
{{/if}}
{{#if (eq video.status "failed")}}
<div class="alert">
  <strong>The project was deleted, but its YouTube video was not.</strong> {{video.error}}<br>
  Delete it by hand in YouTube Studio if you want it gone: <a href="{{video.url}}" target="_blank" rel="noopener">{{video.url}}</a>
</div>
{{/if}}

<p style="font-size:14px;">The page leaves mywindowwashing.com about a minute later, once cPanel pulls the push.</p>

{{#if fromPerformance}}
<a class="btn btn-block" href="/performance" style="text-align:center;margin-bottom:10px;">Back to worst performing projects</a>
{{/if}}
<a class="btn btn-outline btn-block" href="/" style="text-align:center;">Back to dashboard</a>
