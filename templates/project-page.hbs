<script>
var hamburger=document.getElementById('navHamburger'),drawer=document.getElementById('navDrawer'),overlay=document.getElementById('navOverlay'),drawerClose=document.getElementById('navDrawerClose');
function openNav(){drawer.style.display='block';requestAnimationFrame(function(){drawer.classList.add('is-open');});overlay.classList.add('is-open');document.body.style.overflow='hidden';hamburger.setAttribute('aria-expanded','true');}
function closeNav(){drawer.classList.remove('is-open');overlay.classList.remove('is-open');hamburger.setAttribute('aria-expanded','false');setTimeout(function(){drawer.style.display='';document.body.style.overflow='';},260);}
hamburger.addEventListener('click',openNav);drawerClose.addEventListener('click',closeNav);overlay.addEventListener('click',closeNav);
var svcToggle=document.getElementById('drawerServicesToggle'),svcSub=document.getElementById('drawerServicesSub');
svcToggle.addEventListener('click',function(){var open=svcSub.classList.toggle('is-open');svcToggle.classList.toggle('is-open',open);});
</script>
