<div class="card">
  <h2>Submit a completed job</h2>
  <p class="muted">Photos, address, customer review. Takes about 2 minutes.</p>
  <a class="btn btn-block" href="/new" style="text-align:center;">+ New project</a>
  <a class="btn btn-outline btn-block" href="/videos" style="text-align:center;margin-top:10px;">🎬 Upload a video to YouTube</a>
</div>

{{#if drafts.length}}
<div class="card">
  <h2>Your drafts <span style="background:#e3f2fd;color:#0d47a1;padding:2px 10px;border-radius:20px;font-size:13px;margin-left:6px;">{{drafts.length}}</span></h2>
  <p class="muted" style="margin:-8px 0 12px;">Unfinished projects — pick one up where you left off, or delete it.</p>
  <ul class="list pending-list">
    {{#each drafts}}
    <li>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div>
          <strong>{{service_label}} — {{city_name}}, IL</strong>
          <div class="muted" style="font-size:13px;">Slug: <code>{{slug}}</code></div>
          <div class="muted" style="font-size:12px;">Started {{created_at}}</div>
        </div>
        <div class="pending-actions">
          <a class="btn" href="/projects/{{id}}/preview">Resume</a>
          <form method="post" action="/projects/{{id}}/delete" style="display:inline;"
                onsubmit="return confirm('Delete this draft? You’ll have to start over.');">
            <button type="submit" class="btn btn-outline" style="color:#c62828;border-color:#ef9a9a;">Discard</button>
          </form>
        </div>
      </div>
    </li>
    {{/each}}
  </ul>
</div>
{{/if}}

<div class="card">
  <h2>Pending approval {{#if pending.length}}<span style="background:#fff8e1;color:#7a5400;padding:2px 10px;border-radius:20px;font-size:13px;margin-left:6px;">{{pending.length}}</span>{{/if}}</h2>
  {{#if pending.length}}
  <ul class="list pending-list">
    {{#each pending}}
    <li>
      <div style="display:flex;flex-direction:column;gap:6px;">
        <div>
          <strong>{{service_label}} — {{city_name}}, IL</strong>
          <div class="muted" style="font-size:13px;">Hub: {{hub}} · Slug: <code>{{slug}}</code></div>
          <div class="muted" style="font-size:12px;">Submitted {{created_at}}{{#if submitted_by_name}} by {{submitted_by_name}}{{/if}}</div>
        </div>
        <div class="pending-actions">
          <a class="btn btn-outline" href="/projects/{{id}}/preview">Preview / Edit</a>
          <form method="post" action="/projects/{{id}}/publish" style="display:inline;">
            <button type="submit" class="btn">Publish</button>
          </form>
          <form method="post" action="/projects/{{id}}/delete" style="display:inline;"
                onsubmit="return confirm('Delete this project? This cannot be undone.');">
            <button type="submit" class="btn btn-outline" style="color:#c62828;border-color:#ef9a9a;">Delete</button>
          </form>
        </div>
      </div>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="muted">Nothing waiting. New tech submissions will show up here.</p>
  {{/if}}
</div>

<div class="card">
  <h2>Recently published</h2>
  {{#if recent.length}}
  <ul class="list">
    {{#each recent}}
    <li style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
      <div style="flex:1;min-width:0;">
        <strong>{{service_label}} — {{city_name}}, IL</strong>
        <div class="muted" style="font-size:13px;">
          <a href="https://www.mywindowwashing.com/projects/{{slug}}" target="_blank">/{{slug}}</a> · {{published_at}}
        </div>
        {{#if submitted_by_name}}<div class="muted" style="font-size:12px;">Submitted by {{submitted_by_name}}</div>{{/if}}
      </div>
      {{#if @root.currentUser}}{{#if (eq @root.currentUser.role "admin")}}
      <div style="display:flex;gap:6px;flex-shrink:0;">
        <a class="btn btn-outline" href="/projects/{{id}}/edit" style="padding:8px 14px;font-size:13px;">Edit</a>
        <form method="post" action="/projects/{{id}}/delete" style="margin:0;"
              onsubmit="return confirm('Delete this published project? This removes the live page, photos, spoke-page tile, sitemap entry, and DB row. cPanel still needs a deploy to remove it from the live site. Cannot be undone — proceed?');">
          <button type="submit" class="btn" style="padding:8px 14px;font-size:13px;background:#c62828;color:#fff;border:none;">Delete</button>
        </form>
      </div>
      {{/if}}{{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="muted">No projects published yet.</p>
  {{/if}}
</div>

<style>
.pending-list li { padding: 14px 0; }
.pending-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
.pending-actions .btn { padding: 8px 14px; font-size: 14px; }
</style>
