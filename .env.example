# Dashboard auth — single shared password the crew uses to log in
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# HTTP server
PORT=3000

# Anthropic API — used to expand bullet points into the SOP narrative
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Maps JavaScript API key — powers the address autocomplete on
# the new-project form. Enable: Maps JavaScript API + Places API.
# Restrict to HTTP referrer: https://project.mywindowwashing.com/*
GOOGLE_MAPS_API_KEY=

# Optional second key used ONLY by `npm run build-cities` to geocode
# spoke cities server-side. HTTP-referrer restrictions break the
# Geocoding API (no Referer header from Node fetch), so this key is
# typically restricted by IP to the VPS public IP instead and limited
# to the Geocoding API. If unset, build-cities falls back to
# GOOGLE_MAPS_API_KEY.
GOOGLE_GEOCODING_API_KEY=

# Local checkout of the mywindowwashing static site repo.
# The app writes generated HTML/webp here, commits, and pushes.
SITE_REPO_PATH=/srv/mywindowwashing
SITE_REPO_BRANCH=master

# Set to "false" to skip the final `git push` (useful in dev / staging)
SITE_REPO_PUSH=true

# Author identity used for commits the dashboard creates
GIT_AUTHOR_NAME=MWW Dashboard
GIT_AUTHOR_EMAIL=dashboard@mywindowwashing.com
