{{#if showFilters}}
<script>
  // Client-side filter on the master archive: tap a category, hide
  // cards that don't match. URL hash keeps the filter on reload + share.
  (function () {
    var grid = document.getElementById('arc-grid');
    var btns = document.querySelectorAll('.arc-filter-btn');
    function apply(filter) {
      btns.forEach(function (b) {
        b.classList.toggle('is-active', b.dataset.filter === filter);
      });
      grid.querySelectorAll('.arc-card').forEach(function (card) {
        var match = (filter === 'all') || card.dataset.service === filter;
        card.style.display = match ? '' : 'none';
      });
      if (filter === 'all') {
        history.replaceState(null, '', window.location.pathname);
      } else {
        history.replaceState(null, '', '#service=' + filter);
      }
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () { apply(b.dataset.filter); });
    });
    // Restore from URL hash on load
    var m = window.location.hash.match(/service=([\w-]+)/);
    if (m) apply(m[1]);
  })();
</script>
{{/if}}

</body>
