# Dashboard auth — single shared password the crew uses to log in
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# HTTP server
PORT=3000

# Anthropic API — used to expand bullet points into the SOP narrative
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Maps JavaScript API key — powers the address autocomplete on
# the new-project form. Enable: Maps JavaScript API + Places API.
# Restrict to HTTP referrer: https://project.mywindowwashing.com/*
GOOGLE_MAPS_API_KEY=

# Optional second key used ONLY by `npm run build-cities` to geocode
# spoke cities server-side. HTTP-referrer restrictions break the
# Geocoding API (no Referer header from Node fetch), so this key is
# typically restricted by IP to the VPS public IP instead and limited
# to the Geocoding API. If unset, build-cities falls back to
# GOOGLE_MAPS_API_KEY.
GOOGLE_GEOCODING_API_KEY=

# Local checkout of the mywindowwashing static site repo.
# The app writes generated HTML/webp here, commits, and pushes.
SITE_REPO_PATH=/srv/mywindowwashing
SITE_REPO_BRANCH=master

# Set to "false" to skip the final `git push` (useful in dev / staging)
SITE_REPO_PUSH=true

# Author identity used for commits the dashboard creates
GIT_AUTHOR_NAME=MWW Dashboard
GIT_AUTHOR_EMAIL=dashboard@mywindowwashing.com

# Telegram bot used to notify the admin when a tech saves a project
# for approval. Create a bot via @BotFather on Telegram for the token,
# then either DM the bot or add it to a group and use that chat's id.
# Get the chat id by sending any message to the bot and visiting:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# If left blank, the dashboard still works — the notification is just
# silently skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL the Telegram message links back to. Used to build the
# "Review & publish: …" link in the notification body.
DASHBOARD_BASE_URL=https://project.mywindowwashing.com

# YouTube uploads (the /videos page). Google Cloud Console →
# enable "YouTube Data API v3" → Credentials → OAuth client ID
# (type: Web application) with this authorized redirect URI:
#   https://project.mywindowwashing.com/youtube/callback
# Then an admin visits /youtube/connect once to link the channel.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Defaults to DASHBOARD_BASE_URL + /youtube/callback when unset
YOUTUBE_REDIRECT_URI=
# Default visibility preselected on the upload form: public | unlisted | private
YOUTUBE_DEFAULT_PRIVACY=public

# Zernio social API (https://docs.zernio.com) — lets the dashboard post
# a published project straight to the connected Facebook Page instead of
# copy/paste. Leave blank to keep the manual flow (posting no-ops when
# unset). Get the key from the Zernio dashboard → API Keys tab; get the
# account id from the copy icon next to the Facebook account on the
# Connections page, or via:
#   curl -H "Authorization: Bearer <KEY>" https://zernio.com/api/v1/accounts
ZERNIO_API_KEY=
ZERNIO_ACCOUNT_ID=

# Optional — only if the Zernio account manages several Facebook Pages.
# List them with:
#   curl -H "Authorization: Bearer <KEY>" \
#     https://zernio.com/api/v1/accounts/<ACCOUNT_ID>/facebook-page
ZERNIO_FACEBOOK_PAGE_ID=

# Set to "true" to also auto-post to Facebook automatically the moment a
# project is published (in addition to the manual button). Off by default
# because a project's photos must be live on the public domain before
# Zernio can fetch them — if your host deploys the static site on a delay,
# an instant auto-post may run before the images are reachable. The manual
# "Post to Facebook now" button avoids this (press it once the page is up).
ZERNIO_AUTOPOST_ON_PUBLISH=false
