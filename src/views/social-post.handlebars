<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:4px;">
  <h2 style="margin:0;">📣 Create a social post</h2>
  <a class="btn btn-outline" href="{{pageUrl}}" target="_blank" style="padding:8px 14px;font-size:13px;">View live →</a>
</div>
<p class="muted" style="margin:0 0 16px;">{{project.service_label}} — {{project.city_name}}, IL · <code>/{{project.slug}}</code></p>

<div class="card" id="loading-card">
  <p style="margin:0;text-align:center;font-size:15px;">✨ Writing captions for Facebook, Instagram, and LinkedIn…</p>
</div>

<div id="error-card" style="display:none;">
  <div class="alert" id="error-msg"></div>
  <button type="button" class="btn btn-outline btn-block" id="retry-btn">Try again</button>
</div>

<div id="content" style="display:none;">

  <div class="card">
    <h2>1. Pick photos</h2>
    <p class="muted" style="margin:-8px 0 12px;font-size:13px;">Tap the photos you want to share — pick one or several (before + after make the strongest post). Each platform card has a Download button that opens every selected photo so you can save them one tap at a time.</p>
    <div id="photo-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;">
      {{#each photos}}
      <label class="photo-pick">
        <input type="checkbox" name="photo" value="{{url}}" {{#if defaultPick}}checked{{/if}}>
        <img src="{{url}}" alt="{{label}}" loading="lazy">
        <span>{{label}}</span>
      </label>
      {{/each}}
    </div>
    <p class="muted" id="photo-count" style="font-size:12px;margin:10px 0 0;"></p>
  </div>

  <div class="card">
    <h2>2. Hashtags</h2>
    <p class="muted" style="margin:-8px 0 8px;font-size:13px;">Used for Facebook + Instagram (LinkedIn skips them). Edit freely.</p>
    <textarea id="hashtags" rows="3" style="font-family:inherit;font-size:14px;"></textarea>
  </div>

  <div class="card platform-card" data-platform="facebook">
    <h2>📘 Facebook</h2>
    <textarea class="caption" rows="5" style="font-family:inherit;font-size:14px;"></textarea>
    <p class="muted" id="fb-count" style="font-size:12px;margin:4px 0 12px;text-align:right;"></p>
    <div class="action-row">
      <button type="button" class="btn" id="fb-publish-btn" style="background:#1877f2;">🚀 Post to Facebook now</button>
      <button type="button" class="btn copy-btn" data-platform="facebook">📋 Copy caption + hashtags</button>
      <button type="button" class="btn btn-outline download-btn">📷 Download photos</button>
      <a class="btn btn-outline" href="https://www.facebook.com/" target="_blank">↗ Open Facebook</a>
    </div>
    <p class="muted" style="font-size:12px;margin:8px 0 0;"><strong>Post to Facebook now</strong> publishes the caption + selected photos straight to your Page via Zernio. Or copy &amp; paste manually with the buttons on the right.</p>
  </div>

  <div class="card platform-card" data-platform="instagram">
    <h2>📸 Instagram</h2>
    <textarea class="caption" rows="6" style="font-family:inherit;font-size:14px;"></textarea>
    <p class="muted" id="ig-count" style="font-size:12px;margin:4px 0 12px;text-align:right;"></p>
    <div class="action-row">
      <button type="button" class="btn copy-btn" data-platform="instagram">📋 Copy caption + hashtags</button>
      <button type="button" class="btn btn-outline download-btn">📷 Download photos</button>
      <a class="btn btn-outline" href="https://www.instagram.com/" target="_blank">↗ Open Instagram</a>
    </div>
    <p class="muted" style="font-size:12px;margin:8px 0 0;">Instagram posting is mobile-only. Easiest: open the dashboard on your phone, tap Download to save each photo, then make a carousel post from the Instagram app and paste the caption.</p>
  </div>

  <div class="card platform-card" data-platform="linkedin">
    <h2>💼 LinkedIn</h2>
    <textarea class="caption" rows="6" style="font-family:inherit;font-size:14px;"></textarea>
    <p class="muted" id="li-count" style="font-size:12px;margin:4px 0 12px;text-align:right;"></p>
    <div class="action-row">
      <button type="button" class="btn copy-btn" data-platform="linkedin">📋 Copy caption</button>
      <button type="button" class="btn btn-outline download-btn">📷 Download photos</button>
      <a class="btn btn-outline" href="https://www.linkedin.com/feed/?shareActive=true" target="_blank">↗ Open LinkedIn composer</a>
    </div>
  </div>

  <button type="button" class="btn btn-outline btn-block" id="regen-btn" style="margin-top:14px;">⟳ Regenerate all captions</button>
</div>

<a class="btn btn-outline btn-block" href="/" style="text-align:center;margin-top:14px;">Back to dashboard</a>

<style>
.photo-pick { position:relative; cursor:pointer; display:block; border:3px solid transparent; border-radius:8px; overflow:hidden; }
.photo-pick input { position:absolute; opacity:0; }
.photo-pick img { display:block; width:100%; aspect-ratio:3/2; object-fit:cover; background:#f5f8fa; }
.photo-pick span { display:block; padding:6px 8px; font-size:12px; font-weight:600; background:#fff; }
.photo-pick:has(input:checked) { border-color:#4caf50; }
.photo-pick:has(input:checked) span { background:#e8f5e9; color:#2e7d32; }
.action-row { display:flex; gap:8px; flex-wrap:wrap; }
.action-row .btn { padding:10px 14px; font-size:13px; flex:1; min-width:140px; text-align:center; }
.copy-btn.is-copied { background:#2e7d32; }
</style>

<script>
(function () {
  var projectId = {{project.id}};
  var pageUrl   = {{{json pageUrl}}};
  var loadCard  = document.getElementById('loading-card');
  var content   = document.getElementById('content');
  var errCard   = document.getElementById('error-card');
  var errMsg    = document.getElementById('error-msg');
  var hashEl    = document.getElementById('hashtags');
  var photoCount = document.getElementById('photo-count');
  var counters  = { facebook: 'fb-count', instagram: 'ig-count', linkedin: 'li-count' };
  var limits    = { facebook: 63206, instagram: 2200, linkedin: 3000 };

  function el(platform) {
    return document.querySelector('.platform-card[data-platform="' + platform + '"] .caption');
  }
  function pickedPhotos() {
    return Array.prototype.map.call(
      document.querySelectorAll('input[name="photo"]:checked'),
      function (i) { return i.value; }
    );
  }
  function refreshPhotoCount() {
    var n = pickedPhotos().length;
    photoCount.textContent = n === 0
      ? 'No photos selected — pick at least one.'
      : n + ' photo' + (n === 1 ? '' : 's') + ' selected. Each Download button will open them one tab at a time.';
    photoCount.style.color = n === 0 ? '#c62828' : '';
    document.querySelectorAll('.download-btn').forEach(function (b) {
      b.textContent = n > 1 ? '📷 Download ' + n + ' photos' : '📷 Download photo';
      b.disabled = n === 0;
      b.style.opacity = n === 0 ? '.5' : '';
    });
  }
  function refreshCounter(platform) {
    var c = document.getElementById(counters[platform]);
    var n = el(platform).value.length + (platform === 'linkedin' ? 0 : hashEl.value.length + 2);
    c.textContent = n + ' / ' + limits[platform] + ' characters';
    c.style.color = n > limits[platform] ? '#c62828' : '';
  }
  function refreshAllCounters() { ['facebook','instagram','linkedin'].forEach(refreshCounter); }

  function load() {
    loadCard.style.display = 'block';
    content.style.display = 'none';
    errCard.style.display = 'none';
    fetch('/projects/' + projectId + '/social/generate', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.error) throw new Error(data.error);
        el('facebook').value  = data.facebook;
        el('instagram').value = data.instagram;
        el('linkedin').value  = data.linkedin;
        hashEl.value = (data.hashtags || []).map(function (t) { return '#' + t; }).join(' ');
        loadCard.style.display = 'none';
        content.style.display = 'block';
        refreshPhotoCount();
        refreshAllCounters();
      })
      .catch(function (err) {
        loadCard.style.display = 'none';
        errCard.style.display = 'block';
        errMsg.textContent = 'Couldn’t generate captions: ' + err.message;
      });
  }

  document.getElementById('retry-btn').addEventListener('click', load);
  document.getElementById('regen-btn').addEventListener('click', load);

  document.getElementById('photo-grid').addEventListener('change', refreshPhotoCount);
  ['facebook','instagram','linkedin'].forEach(function (p) {
    el(p).addEventListener('input', function () { refreshCounter(p); });
  });
  hashEl.addEventListener('input', refreshAllCounters);

  document.querySelectorAll('.download-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var urls = pickedPhotos();
      if (urls.length === 0) return;
      // Open each photo in a new tab. Popup blockers usually allow
      // multi-window opens that originate from a single click. If
      // the browser blocks tabs 2+, we fall back to opening one and
      // letting the admin re-click for the rest.
      urls.forEach(function (u, i) {
        var w = window.open(u, '_blank');
        if (!w && i > 0) {
          alert('Your browser blocked the extra tabs. Click Download again to grab the next photo.');
        }
      });
    });
  });

  document.querySelectorAll('.copy-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var p = btn.dataset.platform;
      var body = el(p).value;
      var combined = (p === 'linkedin') ? body : (body + '\n\n' + hashEl.value);
      navigator.clipboard.writeText(combined).then(function () {
        var original = btn.textContent;
        btn.textContent = '✓ Copied';
        btn.classList.add('is-copied');
        setTimeout(function () {
          btn.textContent = original;
          btn.classList.remove('is-copied');
        }, 1800);
      }, function () { alert('Couldn’t copy to clipboard. Select the text manually.'); });
    });
  });

  // "Post to Facebook now" — sends the edited caption + hashtags and the
  // selected photo URLs to the server, which relays to Zernio.
  var fbPublishBtn = document.getElementById('fb-publish-btn');
  if (fbPublishBtn) {
    fbPublishBtn.addEventListener('click', function () {
      var urls = pickedPhotos();
      var content = el('facebook').value + '\n\n' + hashEl.value;
      var original = fbPublishBtn.textContent;
      fbPublishBtn.disabled = true;
      fbPublishBtn.textContent = '⏳ Posting…';
      fetch('/projects/' + projectId + '/social/publish-facebook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: content, photoUrls: urls })
      })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          if (!res.ok) throw new Error(res.d.error || 'Post failed');
          fbPublishBtn.textContent = '✅ Posted to Facebook';
          fbPublishBtn.style.background = '#2e7d32';
        })
        .catch(function (err) {
          fbPublishBtn.disabled = false;
          fbPublishBtn.textContent = original;
          alert('Facebook post failed: ' + err.message);
        });
    });
  }

  load();
})();
</script>
