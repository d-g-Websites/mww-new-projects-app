<style>
*, *::before, *::after { box-sizing: border-box; }
body { padding-top: 108px; font-family: "Open Sans", sans-serif; color: #595959; background: #fff; margin: 0; }

/* ── HEADER (same as spokes) ── */
.site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 8000; box-shadow: 0 2px 16px rgba(0,0,0,.28); }
.site-header-top { background: #133047; padding: 10px 20px; }
.site-header-top-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.site-header-top img { height: 44px; width: auto; display: block; }
.site-header-right { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.site-header-phone { color: #fff; font-size: 20px; font-weight: 800; text-decoration: none; display: flex; align-items: center; gap: 7px; white-space: nowrap; }
.site-header-phone svg { width: 18px; height: 18px; stroke: #4caf50; fill: none; stroke-width: 2; }
.site-header-phone:hover { color: #4caf50; text-decoration: none; }
.site-header-cta { background: #4caf50; color: #fff; font-size: 14px; font-weight: 700; padding: 9px 20px; border-radius: 6px; text-decoration: none; white-space: nowrap; transition: background .2s; }
.site-header-cta:hover { background: #388e3c; color: #fff; text-decoration: none; }
.site-header-nav { background: #0d2035; border-top: 1px solid rgba(255,255,255,.08); }
.site-nav-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: stretch; }
.site-nav-inner a, .site-nav-inner .nav-has-dropdown > span { display: flex; align-items: center; padding: 12px 18px; color: rgba(255,255,255,.85); font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; transition: background .18s, color .18s; cursor: pointer; line-height: 1; border: none; background: none; font-family: "Open Sans", sans-serif; }
.site-nav-inner a:hover, .site-nav-inner .nav-has-dropdown:hover > span { background: rgba(255,255,255,.08); color: #fff; }
.nav-has-dropdown { position: relative; }
.nav-has-dropdown > span::after { content: ''; display: inline-block; margin-left: 6px; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid rgba(255,255,255,.7); }
.nav-dropdown { display: none; position: absolute; top: 100%; left: 0; background: #fff; min-width: 220px; z-index: 9000; border-radius: 0 0 8px 8px; box-shadow: 0 8px 24px rgba(0,0,0,.18); padding: 6px 0; }
.nav-has-dropdown:hover .nav-dropdown { display: block; }
.nav-dropdown a { display: block; padding: 9px 18px; color: #133047 !important; font-size: 14px; font-weight: 500; background: none !important; white-space: nowrap; border-bottom: 1px solid #f0f4f7; }
.nav-dropdown a:last-child { border-bottom: none; }
.nav-dropdown a:hover { background: #f5f8fa !important; color: #4caf50 !important; }
.nav-hamburger { display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px; width: 44px; height: 44px; background: none; border: none; cursor: pointer; padding: 0; flex-shrink: 0; }
.nav-hamburger span { display: block; width: 24px; height: 2.5px; background: #fff; border-radius: 2px; }
.nav-drawer { display: none; position: fixed; top: 0; left: 0; bottom: 0; width: 280px; max-width: 85vw; background: #fff; z-index: 9500; overflow-y: auto; transform: translateX(-100%); transition: transform .25s ease; box-shadow: 4px 0 24px rgba(0,0,0,.2); }
.nav-drawer.is-open { transform: translateX(0); }
.nav-drawer-head { background: #133047; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; }
.nav-drawer-head img { height: 36px; width: auto; }
.nav-drawer-close { width: 32px; height: 32px; background: rgba(255,255,255,.15); border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.nav-drawer-close svg { width: 16px; height: 16px; stroke: #fff; fill: none; stroke-width: 2.5; }
.nav-drawer ul { list-style: none; padding: 8px 0; margin: 0; }
.nav-drawer ul li a { display: block; padding: 11px 20px; color: #133047; font-size: 15px; font-weight: 600; text-decoration: none; border-bottom: 1px solid #f0f4f7; }
.nav-drawer ul li a:hover { background: #f5f8fa; color: #4caf50; }
.nav-drawer-toggle { display: flex; align-items: center; justify-content: space-between; padding: 11px 20px; border-bottom: 1px solid #f0f4f7; font-size: 15px; font-weight: 600; color: #133047; cursor: pointer; background: none; width: 100%; border-left: none; border-right: none; border-top: none; font-family: "Open Sans", sans-serif; text-align: left; }
.nav-drawer-toggle svg { width: 16px; height: 16px; stroke: #133047; fill: none; stroke-width: 2.5; transition: transform .2s; }
.nav-drawer-toggle.is-open svg { transform: rotate(180deg); }
.nav-drawer-sub { display: none; background: #f5f8fa; }
.nav-drawer-sub.is-open { display: block; }
.nav-drawer-sub a { padding-left: 34px !important; font-size: 14px !important; font-weight: 500 !important; color: #555 !important; }
.nav-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 9400; }
.nav-overlay.is-open { display: block; }

/* ── BREADCRUMB ── */
.lp-breadcrumb { background: #f0f4f7; padding: 10px 20px; border-bottom: 1px solid #e0e8f0; }
.lp-breadcrumb-inner { max-width: 1100px; margin: 0 auto; font-size: 13px; color: #8a9db0; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.lp-breadcrumb-inner a { color: #133047; text-decoration: none; font-weight: 600; }
.lp-breadcrumb-inner a:hover { color: #4caf50; }
.lp-breadcrumb-inner svg { width: 12px; height: 12px; stroke: #b0bec5; fill: none; stroke-width: 2.5; flex-shrink: 0; }
.lp-breadcrumb-inner span { color: #595959; font-weight: 500; }

/* ── PROJECT HERO ── */
.proj-hero { background: #0d2035 center / cover no-repeat; padding: 52px 20px 44px; position: relative; overflow: hidden; }
.proj-hero.has-bg { padding: 80px 20px 64px; }
.proj-hero-overlay { position: absolute; inset: 0; background: rgba(13,32,53,.85); z-index: 0; }
.proj-hero.has-bg .proj-hero-overlay { background: linear-gradient(180deg, rgba(13,32,53,.72) 0%, rgba(13,32,53,.88) 100%); }
.proj-hero-inner { max-width: 1100px; margin: 0 auto; position: relative; z-index: 1; display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; }
.proj-hooks { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.proj-hook { background: rgba(76,175,80,.18); border: 1px solid rgba(76,175,80,.35); color: #81c784; font-size: 12px; font-weight: 700; padding: 4px 11px; border-radius: 20px; letter-spacing: .3px; text-transform: uppercase; }
.proj-hero h1 { color: #fff; font-size: 32px; font-weight: 800; line-height: 1.2; margin: 0 0 12px; }
.proj-hero h1 span { color: #4caf50; }
.proj-hero-sub { color: rgba(255,255,255,.75); font-size: 16px; line-height: 1.6; margin: 0; max-width: 600px; }
.proj-stat-pill { background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.15); border-radius: 12px; padding: 20px 24px; text-align: center; min-width: 170px; }
.proj-stat-pill .stat-number { color: #4caf50; font-size: 32px; font-weight: 800; line-height: 1; display: block; margin-bottom: 4px; }
.proj-stat-pill .stat-label { color: rgba(255,255,255,.7); font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .4px; display: block; }
.proj-stat-pill .stat-sub { color: rgba(255,255,255,.85); font-size: 13px; font-weight: 600; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.12); display: block; }
.proj-stat-pill .stat-price { color: #4caf50; font-size: 18px; font-weight: 800; margin-top: 6px; display: block; }

/* ── STATS BAR ── */
.proj-stats-bar { background: #133047; padding: 0 20px; }
.proj-stats-bar-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: stretch; }
.proj-stat { display: flex; flex-direction: column; justify-content: center; padding: 18px 0; flex: 1; border-right: 1px solid rgba(255,255,255,.08); }
.proj-stat:last-child { border-right: none; }
.proj-stat-key { color: rgba(255,255,255,.5); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; }
.proj-stat-val { color: #fff; font-size: 15px; font-weight: 700; }
.proj-stat-val.green { color: #4caf50; }

/* ── SECTIONS ── */
.proj-section { padding: 56px 20px; }
.proj-section-inner { max-width: 1100px; margin: 0 auto; }
.proj-section-label { display: inline-flex; align-items: center; gap: 8px; background: #e8f5e9; color: #2e7d32; font-size: 12px; font-weight: 700; padding: 5px 14px; border-radius: 20px; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 16px; }
.proj-section-label svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 2.5; }
.proj-section-title { color: #133047; font-size: 26px; font-weight: 700; margin: 0 0 8px; line-height: 1.25; }
.proj-section-sub { color: #595959; font-size: 16px; margin: 0 0 36px; }

/* ── TECH BYLINE + CARD ── */
.proj-byline { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 18px; font-size: 14px; color: #595959; }
.proj-byline-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; background: #133047; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; flex-shrink: 0; }
.proj-byline-label { color: #8a9db0; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; }
.proj-byline-name { font-weight: 700; color: #133047; font-size: 14px; }
.proj-crew-card { margin-top: 24px; padding: 20px; background: #fff; border: 1px solid #e0e8f0; border-radius: 12px; display: flex; gap: 14px; align-items: center; }
.proj-crew-card img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
.proj-crew-card .ph { width: 64px; height: 64px; border-radius: 50%; background: #133047; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; flex-shrink: 0; }
.proj-crew-card .label { font-size: 11px; font-weight: 700; color: #4caf50; text-transform: uppercase; letter-spacing: .4px; margin: 0 0 4px; }
.proj-crew-card .name { font-size: 16px; font-weight: 700; color: #133047; margin: 0; }
.proj-crew-card .bio  { font-size: 13px; color: #595959; margin: 4px 0 0; line-height: 1.5; }

/* ── NEARBY CITIES ── */
.proj-nearby-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
.proj-nearby-card {
  display: flex; flex-direction: column;
  padding: 18px 14px;
  background: #fff;
  border: 1px solid #e0e8f0;
  border-radius: 12px;
  text-decoration: none;
  text-align: center;
  transition: border-color .15s, box-shadow .15s, transform .15s;
}
.proj-nearby-card:hover {
  border-color: #4caf50;
  box-shadow: 0 6px 18px rgba(76,175,80,.18);
  transform: translateY(-2px);
}
.proj-nearby-service { font-size: 12px; color: #8a9db0; font-weight: 600; margin-bottom: 4px; }
.proj-nearby-city    { font-size: 16px; color: #133047; font-weight: 700; margin-bottom: 8px; line-height: 1.2; }
.proj-nearby-miles   { font-size: 11px; color: #4caf50; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; margin-top: auto; }
@media (max-width: 767px) { .proj-nearby-grid { grid-template-columns: 1fr 1fr; } }
@media (min-width: 768px) and (max-width: 1024px) { .proj-nearby-grid { grid-template-columns: repeat(3, 1fr); } }

/* ── FAQ ── */
.proj-faq { display: flex; flex-direction: column; gap: 12px; max-width: 860px; margin: 0 auto; }
.proj-faq-item { background: #fff; border: 1px solid #e0e8f0; border-radius: 12px; padding: 18px 22px; box-shadow: 0 2px 8px rgba(19,48,71,.04); }
.proj-faq-item summary { font-size: 16px; font-weight: 700; color: #133047; list-style: none; position: relative; padding-right: 36px; cursor: pointer; line-height: 1.4; outline: none; }
.proj-faq-item summary::-webkit-details-marker { display: none; }
.proj-faq-item summary::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 24px; color: #4caf50; font-weight: 700; line-height: 1; transition: transform .2s; }
.proj-faq-item[open] summary::after { content: '−'; }
.proj-faq-item p { margin: 14px 0 0; line-height: 1.7; color: #595959; font-size: 15px; }

/* ── VIDEO SECTION ── */
.proj-video-wrap { display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: center; }
.proj-video-frame { position: relative; width: 100%; padding-top: 56.25%; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 20px rgba(19,48,71,.12); background: #000; }
.proj-video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.proj-video-body p { font-size: 16px; line-height: 1.75; color: #595959; margin: 0 0 14px; }
.proj-video-body p:last-child { margin: 0; }
.proj-video-platform {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  background: #FF0000;
  padding: 11px 20px;
  border-radius: 8px;
  text-decoration: none;
  margin-top: 18px;
  letter-spacing: .3px;
  box-shadow: 0 4px 14px rgba(255,0,0,.30);
  transition: background .2s, transform .15s, box-shadow .2s;
}
.proj-video-platform:hover {
  background: #cc0000;
  color: #fff;
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(255,0,0,.38);
}
.proj-video-platform svg { width: 14px; height: 14px; fill: currentColor; }
@media (max-width: 767px) {
  .proj-video-wrap { grid-template-columns: 1fr; gap: 20px; }
}

/* ── PHOTO GALLERY ── */
.proj-gallery { display: grid; gap: 14px; grid-template-columns: repeat(2, 1fr); }
.proj-gallery a { display: block; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(19,48,71,.10); aspect-ratio: 3 / 2; transition: transform .15s, box-shadow .15s; }
.proj-gallery a:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(19,48,71,.18); }
.proj-gallery img { width: 100%; height: 100%; object-fit: cover; display: block; }
@media (min-width: 768px) {
  .proj-gallery.count-3 { grid-template-columns: repeat(3, 1fr); }
  .proj-gallery.count-4 { grid-template-columns: repeat(4, 1fr); }
  .proj-gallery.count-5 { grid-template-columns: repeat(5, 1fr); }
}

/* ── BEFORE / AFTER ── */
.before-after-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.before-after-card { border-radius: 14px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,.12); position: relative; }
.before-after-card img { width: 100%; height: 380px; object-fit: cover; display: block; }
.before-after-placeholder { width: 100%; height: 380px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; }
.before-after-placeholder.before { background: linear-gradient(135deg, #e8edf2, #d0dae4); }
.before-after-placeholder.after { background: linear-gradient(135deg, #e8f5e9, #c8e6c9); }
.before-after-placeholder svg { width: 56px; height: 56px; opacity: .4; }
.before-after-placeholder .ph-label { font-size: 13px; color: #888; font-weight: 600; }
.ba-badge { position: absolute; top: 16px; left: 16px; padding: 6px 16px; border-radius: 8px; font-size: 13px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; }
.ba-badge.before { background: #133047; color: #fff; }
.ba-badge.after { background: #4caf50; color: #fff; }
.ba-caption { padding: 14px 16px; background: #f5f8fa; font-size: 13px; color: #595959; line-height: 1.5; border-top: 1px solid #e0e8f0; }

/* ── NARRATIVE ── */
.proj-narrative p { font-size: 16px; line-height: 1.8; color: #595959; margin: 0 0 18px; }
.proj-narrative p:last-child { margin: 0; }
.proj-narrative a { color: #133047; font-weight: 600; text-decoration: none; }
.proj-narrative a:hover { color: #4caf50; }

/* ── SERVICE TAGS ── */
.proj-service-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
.proj-service-tag { display: inline-flex; align-items: center; gap: 8px; background: #fff; border: 2px solid #133047; color: #133047; font-size: 14px; font-weight: 700; padding: 9px 18px; border-radius: 8px; text-decoration: none; transition: background .2s, color .2s; }
.proj-service-tag:hover { background: #133047; color: #fff; }
.proj-service-tag svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; }

/* ── REVIEW ── */
.proj-review-card { background: #fff; border-radius: 16px; padding: 36px; box-shadow: 0 4px 24px rgba(19,48,71,.10); border-left: 5px solid #4caf50; max-width: 780px; margin: 0 auto; }
.proj-review-stars { color: #f9a825; font-size: 22px; letter-spacing: 2px; margin-bottom: 16px; }
.proj-review-text { font-size: 18px; line-height: 1.75; color: #133047; font-style: italic; font-weight: 400; margin: 0 0 20px; }
.proj-review-author { display: flex; align-items: center; gap: 12px; }
.proj-review-avatar { width: 44px; height: 44px; border-radius: 50%; background: #133047; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 18px; font-weight: 700; flex-shrink: 0; }
.proj-review-name { font-size: 15px; font-weight: 700; color: #133047; }
.proj-review-meta { font-size: 13px; color: #888; margin-top: 2px; display: flex; align-items: center; gap: 6px; }
.proj-review-meta svg { width: 14px; height: 14px; }
.google-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; color: #4285F4; }

/* ── INTERNAL LINK BLOCK ── */
.proj-link-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.proj-link-card { display: flex; align-items: center; gap: 16px; background: #f5f8fa; border: 1px solid #e0e8f0; border-radius: 14px; padding: 24px; text-decoration: none; transition: border-color .2s, box-shadow .2s, transform .15s; }
.proj-link-card:hover { border-color: rgba(76,175,80,.5); box-shadow: 0 6px 20px rgba(19,48,71,.1); transform: translateY(-2px); }
.proj-link-icon { width: 48px; height: 48px; border-radius: 12px; background: #133047; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.proj-link-icon svg { width: 24px; height: 24px; stroke: #4caf50; fill: none; stroke-width: 2; }
.proj-link-label { font-size: 12px; font-weight: 700; color: #4caf50; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 4px; }
.proj-link-title { font-size: 16px; font-weight: 700; color: #133047; line-height: 1.25; margin-bottom: 2px; }
.proj-link-desc { font-size: 13px; color: #888; }

/* ── RELATED PROJECTS ── */
.proj-related-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 32px; }
.proj-related-card { background: #fff; border: 1px solid #e0e8f0; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 12px rgba(19,48,71,.07); display: flex; flex-direction: column; text-decoration: none; transition: box-shadow .2s, transform .15s; }
.proj-related-card:hover { box-shadow: 0 8px 24px rgba(19,48,71,.13); transform: translateY(-3px); }
.proj-related-img { height: 160px; background: linear-gradient(135deg, #e8f5e9, #c8e6c9); display: flex; align-items: center; justify-content: center; }
.proj-related-img svg { width: 40px; height: 40px; stroke: #4caf50; fill: none; stroke-width: 1.5; opacity: .5; }
.proj-related-body { padding: 18px; flex: 1; display: flex; flex-direction: column; }
.proj-related-tag { display: inline-block; background: #e8f5e9; color: #2e7d32; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 8px; }
.proj-related-title { font-size: 15px; font-weight: 700; color: #133047; line-height: 1.3; margin-bottom: 6px; }
.proj-related-meta { font-size: 12px; color: #999; margin-top: auto; margin-bottom: 0; }

/* ── CTA ── */
.proj-cta { background: linear-gradient(135deg, #133047, #0d2035); padding: 56px 20px; text-align: center; }
.proj-cta h2 { color: #fff; font-size: 28px; font-weight: 800; margin: 0 0 10px; }
.proj-cta p { color: rgba(255,255,255,.75); font-size: 17px; margin: 0 0 28px; }
.btn-cta-green { display: inline-flex; align-items: center; gap: 8px; background: #4caf50; color: #fff; font-size: 16px; font-weight: 700; padding: 14px 32px; border-radius: 8px; text-decoration: none; border: none; cursor: pointer; font-family: "Open Sans", sans-serif; transition: background .2s, transform .15s; box-shadow: 0 4px 14px rgba(76,175,80,.4); }
.btn-cta-green:hover { background: #388e3c; transform: translateY(-1px); color: #fff; }
.btn-cta-green svg { width: 18px; height: 18px; stroke: #fff; fill: none; stroke-width: 2; }
.btn-cta-phone { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: rgba(255,255,255,.85); font-size: 16px; font-weight: 700; padding: 14px 28px; border-radius: 8px; text-decoration: none; border: 2px solid rgba(255,255,255,.3); margin-left: 12px; transition: border-color .2s, color .2s; }
.btn-cta-phone:hover { border-color: #fff; color: #fff; }
.btn-cta-phone svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; }

/* ── FOOTER ── */
.lp-footer-cols { background: #133047; padding: 40px 20px; }
.lp-footer-cols-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap: 32px; }
.lp-footer-col h4 { color: #fff; font-size: 15px; font-weight: 700; margin-bottom: 14px; text-transform: uppercase; letter-spacing: .4px; }
.lp-footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
.lp-footer-col ul li a { color: rgba(255,255,255,.75); font-size: 14px; text-decoration: none; transition: color .2s; }
.lp-footer-col ul li a:hover { color: #4caf50; }
.lp-footer-social { display: flex; gap: 10px; margin-top: 14px; }
.lp-footer-social a { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; text-decoration: none; color: #fff; transition: opacity .2s; }
.lp-footer-social a:hover { opacity: .8; }
.lp-footer-social .fb { background: #3b5998; } .lp-footer-social .ig { background: #ea4c89; } .lp-footer-social .yt { background: #b00; } .lp-footer-social .li { background: #007bb5; }
.lp-footer-bottom { background: #0d0d0d; padding: 16px 20px; text-align: center; }
.lp-footer-bottom p { color: #888; font-size: 13px; margin: 0; }
.lp-footer-bottom a { color: #aaa; text-decoration: none; }
.lp-footer-bottom a:hover { color: #fff; }

/* ── MOBILE CTA ── */
.lp-mobile-cta { display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 9000; grid-template-columns: 1fr 1fr; box-shadow: 0 -3px 16px rgba(0,0,0,.2); }
@media (max-width: 1024px) { .lp-mobile-cta { display: grid; } body { padding-bottom: 58px; } }
.lp-mobile-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 10px; font-family: "Open Sans", sans-serif; font-size: 15px; font-weight: 700; border: none; cursor: pointer; text-decoration: none; }
.lp-mobile-btn svg { width: 18px; height: 18px; flex-shrink: 0; }
.lp-mobile-call { background: #133047; color: #fff; }
.lp-mobile-book { background: #4caf50; color: #fff; }

/* ── RESPONSIVE ── */
@media (max-width: 767px) {
  body { padding-top: 64px; }
  .site-header-nav { display: none; }
  .site-header-phone { display: none; }
  .nav-hamburger { display: flex; }
  .proj-hero-inner { grid-template-columns: 1fr; }
  .proj-stat-pill { display: none; }
  .proj-hero h1 { font-size: 24px; }
  .proj-stats-bar-inner { flex-wrap: wrap; }
  .proj-stat { flex: 0 0 50%; border-right: none; border-bottom: 1px solid rgba(255,255,255,.08); padding: 14px 0; }
  .before-after-grid { grid-template-columns: 1fr; }
  .proj-link-grid { grid-template-columns: 1fr; }
  .proj-related-grid { grid-template-columns: 1fr; }
  .btn-cta-phone { display: none; }
}
@media (min-width: 768px) and (max-width: 1024px) {
  .proj-related-grid { grid-template-columns: 1fr 1fr; }
  .site-header-phone { font-size: 16px; }
}
</style>
</head>
<body>

<!-- ═══ HEADER ═══ -->
<header class="site-header">
  <div class="site-header-top">
    <div class="site-header-top-inner">
      <a href="https://www.mywindowwashing.com"><img src="../images/logo_new.webp" alt="My Window Washing" width="220" height="57"></a>
      <div class="site-header-right">
        <a href="tel:{{hub.phoneDigits}}" class="site-header-phone">
          <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2a1 1 0 011-.25 11.4 11.4 0 003.57.57 1 1 0 011 1V19a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1L6.6 10.8z"/></svg>
          {{hub.phone}}
        </a>
        <a href="https://book.housecallpro.com/book/My-Window-Washing--Property-Refresh/94ea2c069d4049aa9fbc7f74b8247d44" target="_blank" rel="noopener noreferrer" class="site-header-cta">Book Online</a>
        <button class="nav-hamburger" id="navHamburger" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
      </div>
    </div>
  </div>
  <nav class="site-header-nav" aria-label="Main navigation">
    <div class="site-nav-inner">
      <a href="/">Home</a>
      <div class="nav-has-dropdown">
        <span>Services</span>
        <div class="nav-dropdown">
          <a href="../window-washing">Window Washing</a>
          <a href="../gutter-cleaning">Gutter Cleaning</a>
          <a href="../power-washing">Power Washing</a>
          <a href="../commercial-window-cleaning">Commercial Window Cleaning</a>
          <a href="../solar-panel-cleaning">Solar Panel Cleaning</a>
          <a href="../ice-dam-removal">Ice Dam Removal</a>
        </div>
      </div>
      <a href="../coupons">Coupons</a>
      <a href="../contact-us">Contact Us</a>
      <a href="../reviews">Reviews</a>
      <a href="https://www.mywindowwashing.com/blog/">Blog</a>
    </div>
  </nav>
</header>

<div class="nav-overlay" id="navOverlay"></div>
<nav class="nav-drawer" id="navDrawer" aria-label="Mobile navigation">
  <div class="nav-drawer-head">
    <img src="../images/logo_new.webp" alt="My Window Washing" width="160" height="41">
    <button class="nav-drawer-close" id="navDrawerClose" aria-label="Close menu"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
  </div>
  <ul>
    <li><a href="/">Home</a></li>
    <li>
      <button class="nav-drawer-toggle" id="drawerServicesToggle">Services <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></button>
      <ul class="nav-drawer-sub" id="drawerServicesSub">
        <li><a href="../window-washing">Window Washing</a></li>
        <li><a href="../gutter-cleaning">Gutter Cleaning</a></li>
        <li><a href="../power-washing">Power Washing</a></li>
        <li><a href="../commercial-window-cleaning">Commercial Window Cleaning</a></li>
        <li><a href="../solar-panel-cleaning">Solar Panel Cleaning</a></li>
        <li><a href="../ice-dam-removal">Ice Dam Removal</a></li>
      </ul>
    </li>
    <li><a href="../coupons">Coupons</a></li>
    <li><a href="../contact-us">Contact Us</a></li>
    <li><a href="../reviews">Reviews</a></li>
    <li><a href="https://www.mywindowwashing.com/blog/">Blog</a></li>
  </ul>
  <div style="padding:16px 20px;">
    <a href="https://book.housecallpro.com/book/My-Window-Washing--Property-Refresh/94ea2c069d4049aa9fbc7f74b8247d44" target="_blank" rel="noopener noreferrer" style="display:block;background:#4caf50;color:#fff;text-align:center;padding:13px;border-radius:8px;font-weight:700;font-size:15px;text-decoration:none;">Book Online</a>
    <a href="tel:{{hub.phoneDigits}}" style="display:block;background:#133047;color:#fff;text-align:center;padding:13px;border-radius:8px;font-weight:700;font-size:15px;text-decoration:none;margin-top:10px;">{{hub.phone}}</a>
  </div>
</nav>

<!-- ═══ BREADCRUMB ═══ -->
<nav class="lp-breadcrumb" aria-label="Breadcrumb">
  <div class="lp-breadcrumb-inner">
    <a href="/">Home</a>
    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    <a href="/projects/">Projects</a>
    <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    <span>{{service.label}} — {{city.name}}, IL</span>
  </div>
</nav>

<!-- ═══ PROJECT HERO ═══ -->
<div class="proj-hero{{#if heroImage}} has-bg{{/if}}"{{#if heroImage}} style="background-image:url('img/{{heroImage}}');"{{/if}}>
  <div class="proj-hero-overlay"></div>
  <div class="proj-hero-inner">
    <div>
      <div class="proj-hooks">
        <span class="proj-hook">{{service.spokeTag}}</span>
        <span class="proj-hook">{{city.name}}, IL</span>
        {{#if hooks.serviceLevel}}<span class="proj-hook">{{hooks.serviceLevel}}</span>{{/if}}
        <span class="proj-hook">{{dateLabel}}</span>
      </div>
      <h1>{{service.label}} in <span>{{city.name}}, IL</span></h1>
      <p class="proj-hero-sub">{{heroSub}}</p>
    </div>
    {{#if metric.value}}
    <div class="proj-stat-pill">
      <span class="stat-number">{{metric.value}}</span>
      <span class="stat-label">{{metric.label}}</span>
      {{#if serviceTypeLabel}}<span class="stat-sub">{{serviceTypeLabel}}</span>{{/if}}
      {{#if priceLabel}}<span class="stat-price">{{priceLabel}}</span>{{/if}}
    </div>
    {{/if}}
  </div>
</div>

<!-- ═══ STATS BAR ═══ -->
<div class="proj-stats-bar">
  <div class="proj-stats-bar-inner">
    <div class="proj-stat">
      <span class="proj-stat-key">Service</span>
      <span class="proj-stat-val">{{service.spokeTag}}</span>
    </div>
    <div class="proj-stat">
      <span class="proj-stat-key">Location</span>
      <span class="proj-stat-val">{{city.name}}, IL</span>
    </div>
    <div class="proj-stat">
      <span class="proj-stat-key">Home Type</span>
      <span class="proj-stat-val">{{homeType}}</span>
    </div>
    <div class="proj-stat">
      <span class="proj-stat-key">{{metric.label}}</span>
      <span class="proj-stat-val green">{{metric.statBar}}</span>
    </div>
    {{#if serviceTypeLabel}}
    <div class="proj-stat">
      <span class="proj-stat-key">Service Type</span>
      <span class="proj-stat-val">{{serviceTypeLabel}}</span>
    </div>
    {{/if}}
    {{#if priceLabel}}
    <div class="proj-stat">
      <span class="proj-stat-key">Project Price</span>
      <span class="proj-stat-val green">{{priceLabel}}</span>
    </div>
    {{/if}}
    <div class="proj-stat">
      <span class="proj-stat-key">Completed</span>
      <span class="proj-stat-val">{{dateLabel}}</span>
    </div>
  </div>
</div>

<!-- ═══ PROJECT NARRATIVE ═══ -->
<div class="proj-section" style="background:#f5f8fa;">
  <div class="proj-section-inner" style="display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start;">
    <div>
      <div class="proj-section-label"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg> About This Job</div>
      <h2 class="proj-section-title" style="margin-bottom:12px;">What We Did</h2>
      {{#if tech}}
      <div class="proj-byline">
        {{#if tech.photoUrl}}
          <img class="proj-byline-avatar" src="{{tech.photoUrl}}" alt="{{tech.name}}">
        {{else}}
          <span class="proj-byline-avatar">{{#with tech.name}}{{this.[0]}}{{/with}}</span>
        {{/if}}
        <span>
          <span class="proj-byline-label">By</span>
          <span class="proj-byline-name">{{tech.name}}</span>
          <span style="color:#8a9db0;">— {{hub.name}} crew</span>
        </span>
      </div>
      {{/if}}
      <div class="proj-narrative">
        {{#each narrativeParagraphs}}
        <p>{{this}}</p>
        {{/each}}
      </div>
    </div>
    <div>
      <div class="proj-section-label" style="margin-top:4px;"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Services Performed</div>
      <h2 class="proj-section-title" style="margin-bottom:20px;">Scope of Work</h2>
      <div class="proj-service-tags">
        {{#each serviceTags}}
        <a href="../{{../service.servicePage}}" class="proj-service-tag"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>{{this}}</a>
        {{/each}}
      </div>
      {{#if tech}}
      <div class="proj-crew-card">
        {{#if tech.photoUrl}}
          <img src="{{tech.photoUrl}}" alt="{{tech.name}}">
        {{else}}
          <span class="ph">{{#with tech.name}}{{this.[0]}}{{/with}}</span>
        {{/if}}
        <div>
          <p class="label">Crew on this job</p>
          <p class="name">{{tech.name}}</p>
          {{#if tech.bio}}<p class="bio">{{tech.bio}}</p>{{/if}}
        </div>
      </div>
      {{/if}}
      <div style="margin-top:24px;padding:20px;background:#fff;border-radius:12px;border:1px solid #e0e8f0;">
        <p style="font-size:14px;color:#133047;font-weight:700;margin:0 0 6px;">Want a quote for your home?</p>
        <p style="font-size:14px;color:#595959;margin:0 0 14px;">This property is served by our <a href="../{{hub.hubSlug}}" style="color:#133047;font-weight:600;">{{hub.name}} office</a>. Same-day and next-day appointments often available.</p>
        <a href="tel:{{hub.phoneDigits}}" class="btn-cta-green" style="font-size:14px;padding:10px 20px;">
          <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2a1 1 0 011-.25 11.4 11.4 0 003.57.57 1 1 0 011 1V19a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1L6.6 10.8z"/></svg>
          Call {{hub.phone}}
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ═══ BEFORE / AFTER ═══ -->
<div class="proj-section" style="background:#fff;">
  <div class="proj-section-inner">
    <div class="proj-section-label"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg> Before &amp; After</div>
    <h2 class="proj-section-title">The Results</h2>
    <p class="proj-section-sub">{{beforeAfterSub}}</p>

    <div class="before-after-grid">
      <div class="before-after-card">
        <img src="img/{{slug}}-before.webp" alt="{{beforeAlt}}" width="600" height="380">
        <span class="ba-badge before">Before</span>
        <div class="ba-caption">{{beforeCaption}}</div>
      </div>
      <div class="before-after-card">
        <img src="img/{{slug}}-after.webp" alt="{{afterAlt}}" width="600" height="380">
        <span class="ba-badge after">After</span>
        <div class="ba-caption">{{afterCaption}}</div>
      </div>
    </div>
  </div>
</div>

{{#if gallery.length}}
<!-- ═══ PHOTO GALLERY ═══ -->
<div class="proj-section" style="background:#f5f8fa;padding-top:40px;padding-bottom:40px;">
  <div class="proj-section-inner">
    <div class="proj-section-label"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg> Project Photos</div>
    <h2 class="proj-section-title" style="margin-bottom:24px;">More From This Job</h2>
    <div class="proj-gallery count-{{gallery.length}}">
      {{#each gallery}}
      <a href="img/{{this}}" target="_blank" rel="noopener">
        <img src="img/{{this}}" alt="{{../service.label}} project — {{../city.name}}, IL" loading="lazy">
      </a>
      {{/each}}
    </div>
  </div>
</div>
{{/if}}

<!-- ═══ PROJECT NARRATIVE moved up to sit right after the hero ═══ -->

{{#if video}}
<!-- ═══ VIDEO ═══ -->
<div class="proj-section" style="background:#fff;">
  <div class="proj-section-inner">
    <div class="proj-section-label"><svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg> Project Video</div>
    <h2 class="proj-section-title" style="margin-bottom:24px;">{{video.heading}}</h2>
    <div class="proj-video-wrap">
      <div class="proj-video-frame">
        <iframe src="{{video.src}}"
                title="{{service.label}} project video — {{city.name}}, IL"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <div class="proj-video-body">
        {{#each video.body}}<p>{{this}}</p>{{/each}}
        {{#if video.contentUrl}}
        <a href="{{video.contentUrl}}" target="_blank" rel="noopener" class="proj-video-platform">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          Watch on {{video.platform}}
        </a>
        {{/if}}
      </div>
    </div>
  </div>
</div>
{{/if}}

{{#if review.hasAny}}
<!-- ═══ CUSTOMER REVIEW ═══ -->
<div class="proj-section" style="background:#fff;">
  <div class="proj-section-inner">
    <div class="proj-section-label" style="margin:0 auto 16px;display:table;"><svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg> Customer Review</div>

    {{#if review.hasText}}
    <div class="proj-review-card">
      <div class="proj-review-stars">★★★★★</div>
      <p class="proj-review-text">"{{review.text}}"</p>
      <div class="proj-review-author">
        <div class="proj-review-avatar">{{review.initial}}</div>
        <div>
          <div class="proj-review-name">{{review.customerName}}</div>
          <div class="proj-review-meta">
            <span>{{city.name}}, IL · {{dateLabel}}</span>
            {{#if review.url}}
            &nbsp;·&nbsp;
            <a href="{{review.url}}" target="_blank" rel="noopener" class="google-badge" style="text-decoration:none;">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none"><path d="M12 11h8.533C20.8 11.533 21 12.227 21 13c0 4.418-2.985 7-7.5 7-4.142 0-7.5-3.358-7.5-7.5S9.358 5 13.5 5c1.8 0 3.45.633 4.733 1.667L16.5 8.4C15.6 7.533 14.6 7 13.5 7 10.467 7 8 9.467 8 12.5S10.467 18 13.5 18c2.55 0 4.35-1.4 4.9-3.5H12V11z" fill="#4285F4"/></svg>
              Verified on {{review.platform}}
            </a>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
    {{else}}
    <!-- Review URL only — show a clear CTA to read on the source platform -->
    <div class="proj-review-card" style="text-align:center;">
      <div class="proj-review-stars">★★★★★</div>
      <p style="font-size:16px;color:#133047;margin:0 0 22px;">{{#if review.customerName}}{{review.customerName}} left a 5-star review for this project.{{else}}This project earned a 5-star review.{{/if}}</p>
      <a href="{{review.url}}" target="_blank" rel="noopener" class="btn-cta-green" style="font-size:15px;padding:12px 24px;">
        <svg viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Read full review on {{review.platform}}
      </a>
    </div>
    {{/if}}
  </div>
</div>
{{/if}}

<!-- ═══ INTERNAL LINKS ═══ -->
<div class="proj-section" style="background:#f5f8fa;">
  <div class="proj-section-inner">
    <h2 class="proj-section-title" style="margin-bottom:20px;">Served by Our {{hub.name}} Office</h2>
    <div class="proj-link-grid">
      <a href="../{{hub.hubSlug}}" class="proj-link-card">
        <div class="proj-link-icon"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
        <div>
          <div class="proj-link-label">Hub Page</div>
          <div class="proj-link-title">My Window Washing — {{hub.name}}</div>
          <div class="proj-link-desc">{{hub.addressShort}}{{#if hub.addressShort}} · {{/if}}{{hub.phone}}</div>
        </div>
      </a>
      <a href="/projects/" class="proj-link-card">
        <div class="proj-link-icon"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></div>
        <div>
          <div class="proj-link-label">All Projects</div>
          <div class="proj-link-title">Browse All Completed Projects</div>
          <div class="proj-link-desc">Window washing, gutter cleaning, power washing and more</div>
        </div>
      </a>
    </div>
  </div>
</div>

<!-- ═══ RELATED PROJECTS ═══ -->
<div class="proj-section" style="background:#fff;">
  <div class="proj-section-inner">
    <div class="proj-section-label"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg> More Projects</div>
    <h2 class="proj-section-title">Related Projects</h2>
    <div class="proj-related-grid">
      {{#each related}}
      <a href="{{href}}" class="proj-related-card">
