<style>
*, *::before, *::after { box-sizing: border-box; }
body { padding-top: 108px; font-family: "Open Sans", sans-serif; color: #595959; background: #fff; margin: 0; }

/* ── HEADER (same as project pages) ── */
.site-header { position: fixed; top: 0; left: 0; right: 0; z-index: 8000; box-shadow: 0 2px 16px rgba(0,0,0,.28); }
.site-header-top { background: #133047; padding: 10px 20px; }
.site-header-top-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.site-header-top img { height: 44px; width: auto; display: block; }
.site-header-right { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.site-header-phone { color: #fff; font-size: 20px; font-weight: 800; text-decoration: none; display: flex; align-items: center; gap: 7px; white-space: nowrap; }
.site-header-phone svg { width: 18px; height: 18px; stroke: #4caf50; fill: none; stroke-width: 2; }
.site-header-phone:hover { color: #4caf50; }
.site-header-cta { background: #4caf50; color: #fff; font-size: 14px; font-weight: 700; padding: 9px 20px; border-radius: 6px; text-decoration: none; white-space: nowrap; }
.site-header-cta:hover { background: #388e3c; color: #fff; }
.site-header-nav { background: #0d2035; border-top: 1px solid rgba(255,255,255,.08); }
.site-nav-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: stretch; }
.site-nav-inner a { display: flex; align-items: center; padding: 12px 18px; color: rgba(255,255,255,.85); font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; }
.site-nav-inner a:hover { background: rgba(255,255,255,.08); color: #fff; }
.nav-hamburger { display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px; width: 44px; height: 44px; background: none; border: none; cursor: pointer; padding: 0; flex-shrink: 0; }
.nav-hamburger span { display: block; width: 24px; height: 2.5px; background: #fff; border-radius: 2px; }

/* ── BREADCRUMB ── */
.lp-breadcrumb { background: #f0f4f7; padding: 10px 20px; border-bottom: 1px solid #e0e8f0; }
.lp-breadcrumb-inner { max-width: 1100px; margin: 0 auto; font-size: 13px; color: #8a9db0; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.lp-breadcrumb-inner a { color: #133047; text-decoration: none; font-weight: 600; }
.lp-breadcrumb-inner a:hover { color: #4caf50; }
.lp-breadcrumb-inner svg { width: 12px; height: 12px; stroke: #b0bec5; fill: none; stroke-width: 2.5; }
.lp-breadcrumb-inner span { color: #595959; font-weight: 500; }

/* ── ARCHIVE HERO ── */
.arc-hero { background: linear-gradient(135deg, #0d2035, #133047); padding: 56px 20px 44px; color: #fff; }
.arc-hero-inner { max-width: 1100px; margin: 0 auto; }
.arc-hero h1 { font-size: 36px; font-weight: 800; margin: 0 0 12px; line-height: 1.15; }
.arc-hero h1 span { color: #4caf50; }
.arc-hero p { color: rgba(255,255,255,.78); font-size: 17px; line-height: 1.6; max-width: 760px; margin: 0 0 14px; }
.arc-hero-count { display: inline-block; background: rgba(76,175,80,.18); border: 1px solid rgba(76,175,80,.35); color: #81c784; font-size: 13px; font-weight: 700; padding: 5px 14px; border-radius: 20px; letter-spacing: .3px; text-transform: uppercase; }

/* ── FILTER BAR ── */
.arc-filter { background: #fff; padding: 18px 20px; border-bottom: 1px solid #e0e8f0; position: sticky; top: 108px; z-index: 100; }
.arc-filter-inner { max-width: 1100px; margin: 0 auto; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
.arc-filter-label { font-size: 13px; font-weight: 700; color: #8a9db0; text-transform: uppercase; letter-spacing: .4px; margin-right: 8px; }
.arc-filter-btn { background: #f5f8fa; border: 1px solid #e0e8f0; color: #133047; font-size: 14px; font-weight: 700; padding: 9px 18px; border-radius: 22px; cursor: pointer; font-family: inherit; transition: background .15s, color .15s, border-color .15s; }
.arc-filter-btn:hover { background: #e8f5e9; border-color: #a5d6a7; }
.arc-filter-btn.is-active { background: #133047; color: #fff; border-color: #133047; }

/* ── ARCHIVE GRID ── */
.arc-section { padding: 40px 20px 56px; background: #f5f8fa; }
.arc-section-inner { max-width: 1100px; margin: 0 auto; }
.arc-empty { text-align: center; color: #8a9db0; padding: 60px 0; font-size: 16px; }
.arc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.arc-card { background: #fff; border: 1px solid #e0e8f0; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 12px rgba(19,48,71,.07); text-decoration: none; color: inherit; transition: box-shadow .2s, transform .15s; display: flex; flex-direction: column; }
.arc-card:hover { box-shadow: 0 8px 26px rgba(19,48,71,.16); transform: translateY(-3px); }
.arc-card-img { height: 200px; background: linear-gradient(135deg, #e8f5e9, #c8e6c9) center/cover no-repeat; display: flex; align-items: center; justify-content: center; }
.arc-card-img svg { width: 44px; height: 44px; stroke: #4caf50; fill: none; stroke-width: 1.5; opacity: .5; }
.arc-card-body { padding: 18px 20px; flex: 1; display: flex; flex-direction: column; }
.arc-card-tag { display: inline-block; background: #e8f5e9; color: #2e7d32; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 8px; align-self: flex-start; }
.arc-card-title { font-size: 16px; font-weight: 700; color: #133047; line-height: 1.3; margin: 0 0 6px; }
.arc-card-meta { font-size: 13px; color: #888; margin: 0; margin-top: auto; padding-top: 12px; }

/* ── CTA ── */
.proj-cta { background: linear-gradient(135deg, #133047, #0d2035); padding: 56px 20px; text-align: center; }
.proj-cta h2 { color: #fff; font-size: 28px; font-weight: 800; margin: 0 0 10px; }
.proj-cta p { color: rgba(255,255,255,.75); font-size: 17px; margin: 0 0 28px; }
.btn-cta-green { display: inline-flex; align-items: center; gap: 8px; background: #4caf50; color: #fff; font-size: 16px; font-weight: 700; padding: 14px 32px; border-radius: 8px; text-decoration: none; box-shadow: 0 4px 14px rgba(76,175,80,.4); }
.btn-cta-green:hover { background: #388e3c; color: #fff; transform: translateY(-1px); }
.btn-cta-green svg { width: 18px; height: 18px; stroke: #fff; fill: none; stroke-width: 2; }
.btn-cta-phone { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: rgba(255,255,255,.85); font-size: 16px; font-weight: 700; padding: 14px 28px; border-radius: 8px; text-decoration: none; border: 2px solid rgba(255,255,255,.3); margin-left: 12px; }
.btn-cta-phone:hover { border-color: #fff; color: #fff; }
.btn-cta-phone svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 2; }

/* ── FOOTER ── */
.lp-footer-cols { background: #133047; padding: 40px 20px; }
.lp-footer-cols-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px,1fr)); gap: 32px; }
.lp-footer-col h4 { color: #fff; font-size: 15px; font-weight: 700; margin-bottom: 14px; text-transform: uppercase; letter-spacing: .4px; }
.lp-footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
.lp-footer-col ul li a { color: rgba(255,255,255,.75); font-size: 14px; text-decoration: none; }
.lp-footer-col ul li a:hover { color: #4caf50; }
.lp-footer-social { display: flex; gap: 10px; margin-top: 14px; }
.lp-footer-social a { width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; text-decoration: none; color: #fff; }
.lp-footer-social .fb { background: #3b5998; } .lp-footer-social .ig { background: #ea4c89; } .lp-footer-social .yt { background: #b00; } .lp-footer-social .li { background: #007bb5; }
.lp-footer-bottom { background: #0d0d0d; padding: 16px 20px; text-align: center; }
.lp-footer-bottom p { color: #888; font-size: 13px; margin: 0; }
.lp-footer-bottom a { color: #aaa; text-decoration: none; }

/* ── MOBILE STICKY CTA ── */
.lp-mobile-cta { display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 9000; grid-template-columns: 1fr 1fr; box-shadow: 0 -3px 16px rgba(0,0,0,.2); }
@media (max-width: 1024px) { .lp-mobile-cta { display: grid; } body { padding-bottom: 58px; } }
.lp-mobile-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 10px; font-size: 15px; font-weight: 700; border: none; cursor: pointer; text-decoration: none; font-family: "Open Sans", sans-serif; }
.lp-mobile-btn svg { width: 18px; height: 18px; }
.lp-mobile-call { background: #133047; color: #fff; }
.lp-mobile-book { background: #4caf50; color: #fff; }

/* ── RESPONSIVE ── */
@media (max-width: 767px) {
  body { padding-top: 64px; }
  .site-header-nav, .site-header-phone { display: none; }
  .nav-hamburger { display: flex; }
  .arc-hero { padding: 36px 20px 30px; }
  .arc-hero h1 { font-size: 26px; }
  .arc-grid { grid-template-columns: 1fr; }
  .arc-filter { top: 64px; }
  .btn-cta-phone { display: none; }
}
@media (min-width: 768px) and (max-width: 1024px) {
  .arc-grid { grid-template-columns: 1fr 1fr; }
  .site-header-phone { font-size: 16px; }
}
</style>
</head>
<body>

